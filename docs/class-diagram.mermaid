%% LYAdmin 类图（数据模型 + 服务契约）
%% 说明：模型属性为 camelCase，DB 列为 snake_case（Sequelize underscored:true 自动映射）

classDiagram
    direction LR

    class User {
        +number id
        +string username
        +string password
        +string nickname
        +string avatar
        +string email
        +string phone
        +number status
        +Date lastLoginAt
        +Date createdAt
        +Date updatedAt
        +Role[] roles
        +UserRole[] userRoles
    }

    class Role {
        +number id
        +string roleName
        +string roleCode
        +number sort
        +number status
        +string remark
        +User[] users
        +Menu[] menus
    }

    class Menu {
        +number id
        +number parentId
        +string menuName
        +string menuType
        +string path
        +string component
        +string icon
        +string permission
        +number sort
        +number visible
        +number status
        +string redirect
        +number keepAlive
        +Menu[] children
    }

    class UserRole {
        +number id
        +number userId
        +number roleId
    }

    class RoleMenu {
        +number id
        +number roleId
        +number menuId
    }

    class LoginLog {
        +number id
        +string username
        +string ip
        +string userAgent
        +number status
        +string message
        +Date loginAt
    }

    class OperationLog {
        +number id
        +number userId
        +string username
        +string module
        +string action
        +string method
        +string url
        +string params
        +number duration
        +number result
        +string errorMessage
        +string ip
        +Date createdAt
    }

    class File {
        +number id
        +string originName
        +string fileName
        +string filePath
        +string fileUrl
        +string mimeType
        +number size
        +number uploaderId
        +Date createdAt
    }

    User "1" --> "*" UserRole : hasMany
    Role "1" --> "*" UserRole : hasMany
    User "1" --> "*" Role : belongsToMany
    Role "1" --> "*" Menu : belongsToMany
    Role "1" --> "*" RoleMenu : hasMany
    Menu "1" --> "*" RoleMenu : hasMany
    Menu "1" --> "*" Menu : self(parentId)
    User "1" ..> "*" LoginLog : logical(username)
    User "1" ..> "*" OperationLog : logical(userId)
    User "1" ..> "*" File : logical(uploaderId)

    class AuthService {
        +login(username, password, ip, ua) LoginResult
        +refresh(refreshToken) TokenPair
        +getProfile(userId) UserProfile
        +getMenus(userId) MenuNode[]
    }
    class UserService {
        +paginate(query) PageResult
        +create(dto) UserDetail
        +update(id, dto) UserDetail
        +remove(id) void
        +changeStatus(id, status) void
        +resetPassword(id, password) void
        +assignRoles(id, roleIds) void
    }
    class RoleService {
        +paginate(query) PageResult
        +create(dto) Role
        +update(id, dto) Role
        +remove(id) void
        +getMenuIds(id) number[]
        +assignMenus(id, menuIds) void
    }
    class MenuService {
        +list(query) MenuNode[]
        +tree() MenuNode[]
        +create(dto) Menu
        +update(id, dto) Menu
        +remove(id) void
    }
    class LogService {
        +loginLogs(query) PageResult
        +operationLogs(query) PageResult
        +httpLogs(query) PageResult
        +writeLoginLog(dto) void
        +writeOperationLog(dto) void
    }
    class FileService {
        +save(files, uploaderId) FileItem[]
        +paginate(query) PageResult
        +remove(id) void
    }
    class DashboardService {
        +stats() Stats
        +loginTrend(days) Trend
        +operationDistribution() Slice[]
        +roleUserCount() BarData
    }
    class ProfileService {
        +update(userId, dto) UserBrief
        +changePassword(userId, dto) void
        +changeAvatar(userId, url) string
    }

    AuthService ..> User
    AuthService ..> Menu
    AuthService ..> LoginLog
    UserService ..> User
    UserService ..> UserRole
    RoleService ..> Role
    RoleService ..> RoleMenu
    MenuService ..> Menu
    LogService ..> LoginLog
    LogService ..> OperationLog
    FileService ..> File
    DashboardService ..> User
    DashboardService ..> Role
    DashboardService ..> LoginLog
    ProfileService ..> User
