# 统一换行符策略：默认交给 Git 自动判断，但 shell 脚本与 Git 钩子强制使用 LF，
# 否则 Windows 下检出的 CRLF 会导致 husky 钩子在类 Unix 环境报 "bad interpreter"。

* text=auto

# Git 钩子与脚本必须保持 LF
.husky/* text eol=lf
*.sh text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
