# 部署环境变量模板（复制为 deploy/.env 后按需修改）
#
#   cp deploy/.env.example deploy/.env
#
# 说明：
# - 本文件会进仓库；`deploy/.env` 被 .gitignore 忽略（`.env` 规则），不会误提交密钥。
# - 标记「必需」的变量缺失时，compose 会用 `${VAR:?提示}` 直接报错退出（不做静默兜底），
#   因为后端 config.ts 对 JWT 密钥也没有默认值，缺失即拒绝启动——提前在编排层失败更易排查。
# - 不在这里出现的变量走代码默认值，完整清单见 knowledge/后端开发规范/03-环境与配置.md。

# ---------- 必需 ----------
# MySQL root 口令。⚠️ 仅本机自建库够用；生产建议单独建受限账号并只授业务库权限。
DB_PASSWORD=change-me-local-mysql

# 两个 JWT 密钥：必需、必须互不相同，长度建议 ≥32 字节。
# 生成：openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-bytes

# ---------- 建议 ----------
# 超管 admin 的初始口令。留空会用代码里的开发默认弱口令（且仅在非 production 打 warn），
# 首次部署务必显式设置。
SEED_ADMIN_PASSWORD=change-me-admin-password

# ---------- 可选（有默认值） ----------
# 数据库名（compose 用它初始化 MySQL 并作为 API 的 DB_NAME）
DB_NAME=ly_admin

# 宿主机映射端口（只有 api 对外暴露）
HOST_PORT=3000

# 同源部署保持 *；前后端分离部署必须写成前端域名白名单（逗号分隔）
CORS_ORIGIN=*

# 登录图形验证码（生产建议保持开启）
CAPTCHA_ENABLED=true

# 单文件大小上限（字节）。改了要同步 deploy/nginx.conf 的 client_max_body_size
UPLOAD_MAX_SIZE=10485760

# 单用户累计上传配额（MB，0 = 不限）：防止单个账号塞满磁盘
UPLOAD_USER_QUOTA_MB=512

# HTTP 访问日志保留天数（超期由定时任务清理）
LOG_HTTP_RETENTION_DAYS=7

# 会出现在 /api/health/live 里，便于确认线上跑的是哪个版本/提交（可由 CI 注入）
APP_VERSION=dev
GIT_COMMIT=