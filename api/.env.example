NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ly_admin
DB_USER=root
DB_PASSWORD=your_password
DB_LOGGING=false

JWT_ACCESS_SECRET=ly_admin_access_secret
JWT_REFRESH_SECRET=ly_admin_refresh_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_COUNT=10

CORS_ORIGIN=http://localhost:5173
LOG_DIR=logs
