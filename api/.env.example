NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ly_admin
DB_USER=root
DB_PASSWORD=your_password
# 数据库日志（SQL 写入 logs/db/ 日志文件）：默认开启；设为 false 可关闭
DB_LOGGING=true

# JWT 密钥（必填，缺失或为空将拒绝启动；两个密钥必须互不相同）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 严禁使用任何可预测的默认值。
JWT_ACCESS_SECRET=<必填：32 字节随机 hex>
JWT_REFRESH_SECRET=<必填：32 字节随机 hex>
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 反向代理信任跳数（仅当部署在反向代理之后才设置，值=代理跳数，如 1；默认不设置=不信任 X-Forwarded-For）
# TRUST_PROXY=1

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_COUNT=10
# 图片缩放缓存目录（相对 api/，默认 cache/images）。
# 注意：必须位于 UPLOAD_DIR 之外，否则缓存文件会被静态服务公开访问。
# UPLOAD_CACHE_DIR=cache/images

CORS_ORIGIN=http://localhost:5173
LOG_DIR=logs

# 归档根目录（可选，默认 <LOG_DIR>/archive）
# LOG_ARCHIVE_DIR=logs/archive
# 归档时刻（本地时间，默认次日 00:05 归档昨日）
LOG_ARCHIVE_HOUR=0
LOG_ARCHIVE_MINUTE=5
# 归档成功后是否保留源 .log（默认 false=删除）
LOG_ARCHIVE_KEEP_SOURCE=false
# 慢 SQL 阈值（ms）
LOG_SLOW_SQL_MS=200
# 自定义 tar 可执行文件（默认 PATH 中的 tar）
# TAR_BIN=tar

# ── 日志保留策略（按时间列分批 DELETE 自动清理，每日 00:10 触发；单位：天）──
# 保留天数须为**正整数**：设为 0 / 负数 / 非法值时将被拒绝、回退默认值并打印告警（防“0=清空整表”事故）。
# HTTP 访问日志（sys_http_log）保留天数：默认 7。该表是磁盘增长主源，取证价值随时间快速衰减。
LOG_HTTP_RETENTION_DAYS=7
# 操作日志（sys_operation_log）保留天数：默认 180。审计证据，需长期保留。
LOG_OPERATION_RETENTION_DAYS=180
# 登录日志（sys_login_log）保留天数：默认 180（折中）。
LOG_LOGIN_RETENTION_DAYS=180
# 保留清理触发时刻（本地时间，默认 00:10，刻意避开 00:05 归档以避免同一时刻抢 IO）
LOG_RETENTION_HOUR=0
LOG_RETENTION_MINUTE=10
# 是否启用日志保留清理：默认 true；设 false 为紧急刹车（不注册调度器、不执行清理，启动日志会显示“已禁用”）
LOG_RETENTION_ENABLED=true
# HTTP 日志 count 短 TTL（30s）缓存调试日志（默认 false；仅用于验证缓存命中）
# LOG_HTTP_COUNT_CACHE_DEBUG=false
