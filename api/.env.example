NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ly_admin
DB_USER=root
DB_PASSWORD=your_password
# 数据库日志（SQL 写入 logs/db/ 日志文件）：默认开启；设为 false 可关闭
DB_LOGGING=true

JWT_ACCESS_SECRET=ly_admin_access_secret
JWT_REFRESH_SECRET=ly_admin_refresh_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_COUNT=10

CORS_ORIGIN=http://localhost:5173
LOG_DIR=logs

# 归档根目录（可选，默认 <LOG_DIR>/archive）
# LOG_ARCHIVE_DIR=logs/archive
# 归档时刻（本地时间，默认次日 00:05 归档昨日）
LOG_ARCHIVE_HOUR=0
LOG_ARCHIVE_MINUTE=5
# 归档成功后是否保留源 .log（默认 false=删除）
LOG_ARCHIVE_KEEP_SOURCE=false
# 慢 SQL 阈值（ms）
LOG_SLOW_SQL_MS=200
# 自定义 tar 可执行文件（默认 PATH 中的 tar）
# TAR_BIN=tar
