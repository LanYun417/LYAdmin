{
  "name": "ly-admin",
  "version": "1.0.0",
  "private": true,
  "description": "蓝云后台管理系统（LYAdmin）· 单仓工程规范根目录",
  "author": "LYAdmin Team",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,vue,json,css,scss,md,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,vue,json,css,scss,md,html}\"",
    "stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "guard:deps": "node scripts/deps-guard.mjs",
    "guard:deps:update": "node scripts/deps-guard.mjs --update",
    "guard:imports": "node scripts/check-tracked-imports.mjs",
    "guard:locale": "node scripts/check-locale-keys.mjs",
    "commit": "cz",
    "dev:api": "npm --prefix ly-admin-api run start:dev",
    "dev:web": "npm --prefix ly-admin-web run dev",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript-eslint": "^8.70.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
