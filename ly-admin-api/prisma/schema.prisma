// use prisma-next
// ↑ 首行必须保留（且必须是「 // use prisma-next 」独占一行）：
//   VS Code 的 Prisma 扩展用正则 /^\s*\/\/ *use +prisma-(?:next|8) *(?!\S)/ 判定本文件是否
//   属于 Prisma 7——只有匹配上才会启用 Prisma 7 语言服务。缺失时扩展会回落到 Prisma 6
//   语言服务，后者按 v6 语义要求 datasource 必须带 url，从而误报
//   `Argument "url" is missing in data source block "db"`（而 Prisma 7 早已禁止 schema 里写 url）。
//
// LYAdmin 后端数据模型（NestJS + Prisma）
//
// 迁移自原 Sequelize 模型，逐表 1:1 对齐：
// - 主键沿用 BIGINT → Prisma BigInt（@db.BigInt），JS 侧统一 Number() 转换
// - **列名一律 @map 成 snake_case**：原 Sequelize 模型统一 `underscored: true`（另有 4 处显式
//   field 覆盖：last_login_at / password_changed_at / login_at / keep_alive，取值同为 snake_case），
//   所以库内列名是 dept_id / created_at 这种形式。Prisma 默认拿字段名（camelCase）当列名，
//   不 @map 就会造出 deptId / createdAt 列——既与既有库不符，也会让仍在运行的旧 Express
//   后端（api/）直接报 Unknown column。此处 Prisma 字段名保持 camelCase（业务代码零改动），
//   仅用 @map 落到 snake_case 列。
// - 哨兵值约定（0 不在表内，建外键会被约束拒绝），对应原模型的 `constraints: false`：
//   · sys_menu.parent_id / sys_dept.parent_id（0 = 根节点/顶级）→ 不声明 Prisma 自关联
//   · sys_user.dept_id（0 = 未分配）→ 不声明 Prisma 关系，部门名由业务层按 deptId 显式查询
// - 其余关联保留数据库外键，与原 Sequelize 关联默认行为一致：
//   中间表（sys_user_role / sys_role_menu / sys_role_dept）与 dict_item → dict_type（含级联删除）。
//
// 与原 Sequelize 模型的差异说明：
// - 原 `INT UNSIGNED` / `SMALLINT UNSIGNED` 列（File.size、HttpLog.statusCode、HttpLog.duration）
//   在 Prisma 的 MySQL connector 中不支持 unsigned 原生类型，改用有符号 Int。
//   三者均为非负语义（文件字节数、HTTP 状态码、耗时毫秒），且应用层已做上界校验，行为等价。
//
// 文档注释（`///`）与数据库 COMMENT 的关系（重要）：
// - `///` 是 Prisma 的 schema 级文档注释，只进 DMMF 与 Prisma Client 的 JSDoc，**不会写进数据库**：
//   `prisma db push` 不带注释、`prisma db pull` 也读不回（已实测）。
// - 表/字段的数据库 COMMENT 由 `npm run prisma:comments`（scripts/prisma-comments.ts）从本文件的
//   `///` 生成 DDL 同步到库，幂等、可重复执行；`npm run prisma:comments:check` 检查是否漂移（CI 友好）。
// - 因此**改表/字段说明请改本文件的 `///`**，改完执行同步命令。`db push --force-reset` 会重建表
//   并清空注释，重建后重新执行 `npm run prisma:comments` 即可恢复。
// - 这些注释并非装饰：代码生成器（tool:gen）从 information_schema 读 TABLE_COMMENT / COLUMN_COMMENT
//   作为业务名与表单字段标签，缺失时生成物会退化为英文列名。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // 生成 ESM 兼容代码（带 .js 扩展名导入），以便在 Node ESM 运行时直接使用
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// 连接串来源（Prisma 7 硬性约定）：
// - Prisma 7 已**彻底移除** schema 里的 `datasource.url`，写了会直接报
//   `The datasource property `url` is no longer supported in schema files`（P1012）。
//   CLI（db push / migrate / introspect）的连接串只来自 prisma.config.ts；
//   运行期连接由 PrismaService 通过 driver adapter 注入（见 src/prisma/prisma.service.ts）。
// - IDE 侧注意点：VS Code 的 Prisma 扩展若被钉在 Prisma 6 语义
//   （.vscode/settings.json 的 prisma.pinToPrisma6=true），会按 v6 规则要求 datasource 带 url，
//   从而误报 `Argument "url" is missing in data source block "db"`。本项目为 Prisma 7，
//   已显式关闭该 pin（并在本文件首行声明 // use prisma-next）以启用 Prisma 7 语言服务。
datasource db {
  provider = "mysql"
}

/// 用户表
model User {
  /// 主键
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  /// 登录账号
  username          String    @unique @db.VarChar(50)
  /// bcrypt 哈希
  password          String    @db.VarChar(100)
  /// 昵称
  nickname          String    @default("") @db.VarChar(50)
  /// 头像 URL
  avatar            String?   @db.VarChar(255)
  /// 邮箱
  email             String?   @db.VarChar(100)
  /// 手机号
  phone             String?   @db.VarChar(20)
  /// 性别（字典 sys_user_sex），字符串存储以便字典值扩展
  gender            String?   @db.VarChar(20)
  /// 1 启用 / 0 禁用
  status            Int       @default(1) @db.TinyInt
  /// 最后登录时间
  lastLoginAt       DateTime? @map("last_login_at")
  /// 密码最后修改时间
  passwordChangedAt DateTime? @map("password_changed_at")
  /// 备注
  remark            String?   @db.VarChar(255)
  /// 部门 id（0 表示未分配，故不建外键、也不声明 Prisma 关系）
  deptId            BigInt    @default(0) @map("dept_id") @db.BigInt
  /// 创建时间
  createdAt         DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime  @updatedAt @map("updated_at")

  /// 经中间表 UserRole 的直接角色关联。
  /// ⚠️ 必须走显式中间表 `sys_user_role`（`userRoles.role`），**不要**改回隐式多对多：
  ///    隐式 `Role[]` 关系会让 Prisma 另建一张 `_userroles` 表，而业务与旧后端读写的是
  ///    `sys_user_role`，两者不通——表现为角色恒为空、权限码为空、所有带权限码的接口 403、
  ///    前端菜单树为空（2026-10-16 实际踩过）。
  userRoles UserRole[]

  @@index([deptId])
  @@map("sys_user")
}

/// 角色表
model Role {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 角色名称
  roleName  String   @map("role_name") @db.VarChar(50)
  /// 角色编码
  roleCode  String   @unique @map("role_code") @db.VarChar(50)
  /// 排序
  sort      Int      @default(0)
  /// 1 启用 / 0 禁用
  status    Int      @default(1) @db.TinyInt
  /// 数据权限范围：1 全部 / 2 自定义部门 / 3 本部门及以下 / 4 仅本人
  dataScope Int      @default(1) @map("data_scope") @db.TinyInt
  /// 备注
  remark    String?  @db.VarChar(255)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 同样只走显式中间表（见 User 模型上的说明，勿改回隐式多对多）
  userRoles UserRole[]
  roleMenus RoleMenu[]
  roleDepts RoleDept[]

  @@map("sys_role")
}

/// 菜单权限表
model Menu {
  /// 主键
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  /// 父级 id（0 表示根节点，故不建外键、也不声明 Prisma 自关联）
  parentId   BigInt   @default(0) @map("parent_id") @db.BigInt
  /// 菜单名称
  menuName   String   @map("menu_name") @db.VarChar(50)
  /// M 目录 / C 菜单 / F 按钮
  menuType   String   @map("menu_type") @db.Char(1)
  /// 路由路径
  path       String?  @db.VarChar(200)
  /// 组件路径
  component  String?  @db.VarChar(255)
  /// 图标
  icon       String?  @db.VarChar(100)
  /// 权限标识
  permission String?  @db.VarChar(100)
  /// 排序
  sort       Int      @default(0)
  /// 1 显示 / 0 隐藏
  visible    Int      @default(1) @db.TinyInt
  /// 1 启用 / 0 禁用
  status     Int      @default(1) @db.TinyInt
  /// 重定向
  redirect   String?  @db.VarChar(255)
  /// 1 缓存 / 0 不缓存
  keepAlive  Int      @default(0) @map("keep_alive") @db.TinyInt
  /// 创建时间
  createdAt  DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt  DateTime @updatedAt @map("updated_at")

  roleMenus RoleMenu[]

  @@index([parentId])
  @@map("sys_menu")
}

/// 部门表
model Dept {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 父级 id（0 表示顶级，故不建外键、也不声明 Prisma 自关联）
  parentId  BigInt   @default(0) @map("parent_id") @db.BigInt
  /// 部门名称
  deptName  String   @map("dept_name") @db.VarChar(50)
  /// 排序
  sort      Int      @default(0)
  /// 1 启用 / 0 禁用
  status    Int      @default(1) @db.TinyInt
  /// 部门负责人
  leader    String?  @db.VarChar(20)
  /// 联系电话
  phone     String?  @db.VarChar(20)
  /// 邮箱
  email     String?  @db.VarChar(100)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  roleDepts RoleDept[]

  @@index([parentId])
  @@map("sys_dept")
}

/// 用户角色关联表
model UserRole {
  /// 主键
  id     BigInt @id @default(autoincrement()) @db.BigInt
  /// 用户 id
  userId BigInt @map("user_id") @db.BigInt
  /// 角色 id
  roleId BigInt @map("role_id") @db.BigInt

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("sys_user_role")
}

/// 角色菜单关联表
model RoleMenu {
  /// 主键
  id     BigInt @id @default(autoincrement()) @db.BigInt
  /// 角色 id
  roleId BigInt @map("role_id") @db.BigInt
  /// 菜单 id
  menuId BigInt @map("menu_id") @db.BigInt

  role Role @relation(fields: [roleId], references: [id])
  menu Menu @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
  @@index([menuId])
  @@map("sys_role_menu")
}

/// 角色数据权限部门关联表（承载 data_scope=2 的自定义部门集合）
model RoleDept {
  /// 主键
  id     BigInt @id @default(autoincrement()) @db.BigInt
  /// 角色 id
  roleId BigInt @map("role_id") @db.BigInt
  /// 部门 id
  deptId BigInt @map("dept_id") @db.BigInt

  role Role @relation(fields: [roleId], references: [id])
  dept Dept @relation(fields: [deptId], references: [id])

  @@unique([roleId, deptId])
  @@index([deptId])
  @@map("sys_role_dept")
}

/// 字典类型表
model DictType {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 字典名称（展示用）
  dictName  String   @map("dict_name") @db.VarChar(100)
  /// 字典类型编码（业务引用键，创建后不可修改）
  dictType  String   @unique @map("dict_type") @db.VarChar(100)
  /// 1 启用 / 0 禁用
  status    Int      @default(1) @db.TinyInt
  /// 备注
  remark    String?  @db.VarChar(255)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  items DictItem[]

  @@map("sys_dict_type")
}

/// 字典项表（通过 dict_type 字符串关联类型编码，删除类型时级联）
model DictItem {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 所属字典类型编码
  dictType  String   @map("dict_type") @db.VarChar(100)
  /// 字典标签（展示文案）
  dictLabel String   @map("dict_label") @db.VarChar(100)
  /// 字典值（业务存储值）
  dictValue String   @map("dict_value") @db.VarChar(100)
  /// 排序（升序）
  sort      Int      @default(0)
  /// 1 启用 / 0 禁用
  status    Int      @default(1) @db.TinyInt
  /// 备注
  remark    String?  @db.VarChar(255)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  dictTypeInfo DictType @relation(fields: [dictType], references: [dictType], onDelete: Cascade, onUpdate: Cascade)

  @@index([dictType])
  @@map("sys_dict_item")
}

/// 系统参数表
model SysConfig {
  /// 主键
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  /// 参数名称（展示用）
  configName  String   @map("config_name") @db.VarChar(100)
  /// 参数键名（业务引用键，创建后不可修改）
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  /// 参数键值
  configValue String   @default("") @map("config_value") @db.VarChar(500)
  /// 是否内置：1 内置 / 0 自定义
  systemFlag  Int      @default(0) @map("system_flag") @db.TinyInt
  /// 备注
  remark      String?  @db.VarChar(255)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sys_config")
}

/// 文件表
model File {
  /// 主键
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  /// 原始文件名
  originName String   @map("origin_name") @db.VarChar(255)
  /// 存储文件名
  fileName   String   @map("file_name") @db.VarChar(255)
  /// 磁盘相对路径
  filePath   String   @map("file_path") @db.VarChar(500)
  /// 访问 URL
  fileUrl    String   @map("file_url") @db.VarChar(500)
  /// MIME
  mimeType   String   @map("mime_type") @db.VarChar(100)
  /// 字节
  size       Int      @default(0) @db.Int
  /// SHA-256 内容哈希（秒传/去重依据）
  hash       String?  @db.VarChar(64)
  /// 上传人 id
  uploaderId BigInt?  @map("uploader_id") @db.BigInt
  /// 创建时间
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([hash])
  @@map("sys_file")
}

/// 登录日志表
model LoginLog {
  /// 主键
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  /// 登录账号
  username  String   @db.VarChar(50)
  /// 客户端 IP
  ip        String?  @db.VarChar(50)
  /// User-Agent
  userAgent String?  @map("user_agent") @db.VarChar(500)
  /// 1 成功 / 0 失败
  status    Int      @db.TinyInt
  /// 结果描述
  message   String?  @db.VarChar(255)
  /// 登录时间
  loginAt   DateTime @default(now()) @map("login_at")

  @@index([loginAt])
  @@map("sys_login_log")
}

/// 操作日志表
model OperationLog {
  /// 主键
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  /// 操作人 id
  userId       BigInt?  @map("user_id") @db.BigInt
  /// 操作人账号
  username     String?  @db.VarChar(50)
  /// 模块
  module       String   @db.VarChar(50)
  /// 动作
  action       String   @db.VarChar(50)
  /// HTTP 方法
  method       String   @db.VarChar(10)
  /// 请求 URL
  url          String   @db.VarChar(255)
  /// 请求参数（密码脱敏）
  params       String?  @db.Text
  /// 耗时 ms
  duration     Int      @default(0)
  /// 1 成功 / 0 失败
  result       Int      @db.TinyInt
  /// 失败信息
  errorMessage String?  @map("error_message") @db.VarChar(500)
  /// 客户端 IP
  ip           String?  @db.VarChar(50)
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sys_operation_log")
}

/// HTTP 访问日志表（页面查询用；操作者为写入时快照，不与 sys_user 建外键）
model HttpLog {
  /// 主键
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  /// 请求完成时间（本地时区 +08:00）
  time       DateTime @db.DateTime(3)
  /// HTTP 方法
  method     String   @db.VarChar(10)
  /// 请求 URL（含 query）
  url        String   @db.VarChar(1024)
  /// HTTP 状态码
  statusCode Int      @map("status_code") @db.SmallInt
  /// 耗时 ms
  duration   Int      @default(0) @db.Int
  /// 客户端 IP
  ip         String?  @db.VarChar(64)
  /// User-Agent
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  /// 操作用户 id（0 为匿名/未登录）
  userId     BigInt   @default(0) @map("user_id") @db.BigInt
  /// 操作账号（快照）
  username   String?  @db.VarChar(50)
  /// 所属部门 id 快照（0 为无）
  deptId     BigInt   @default(0) @map("dept_id") @db.BigInt
  /// 所属部门名称（快照）
  deptName   String?  @map("dept_name") @db.VarChar(50)
  /// 查询参数（已脱敏）
  query      Json?
  /// 请求体（已脱敏、截断 2KB）
  reqBody    String?  @map("req_body") @db.Text
  /// 响应内容（截断 2KB；二进制为占位）
  resBody    String?  @map("res_body") @db.Text

  @@index([time])
  @@index([method])
  @@index([statusCode])
  @@index([method, time])
  // 操作者筛选索引：原旧后端由种子里的幂等迁移补建（idx_user_id / idx_dept_id），
  // 这里显式声明，保证「旧后端删除后」的全新部署同样有这两个索引
  @@index([userId])
  @@index([deptId])
  @@map("sys_http_log")
}

