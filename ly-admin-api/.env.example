NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ly_admin
DB_USER=root
DB_PASSWORD=your_password
# 可选：直接给出完整连接串（优先级高于上面的 DB_*，供 Prisma CLI 使用）。
# Prisma 7 的 schema 不再接受 datasource.url，连接串统一由 prisma.config.ts 提供；
# 未设置本项时，prisma.config.ts 会用 DB_* 拼装（密码走 encodeURIComponent，特殊字符安全）。
# DATABASE_URL=mysql://root:your_password@localhost:3306/ly_admin
# 是否记录 Prisma 查询事件（用于慢 SQL 日志 db-*.log）
DB_LOGGING=true
# 连接池上限（默认 10，范围 1~100）
DB_CONNECTION_LIMIT=10

# JWT 密钥（必填，缺失或为空将拒绝启动；两个密钥必须互不相同）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 严禁使用任何可预测的默认值。
JWT_ACCESS_SECRET=<必填：32 字节随机 hex>
JWT_REFRESH_SECRET=<必填：32 字节随机 hex>
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ── 登录图形验证码 ──
# 是否启用登录图形验证码（默认 true）；设 false 可关闭（如自动化测试环境）
CAPTCHA_ENABLED=true
# 验证码有效期（ms，默认 5 分钟）
# CAPTCHA_TTL_MS=300000
# 验证码字符数（默认 4）
# CAPTCHA_LENGTH=4

# 反向代理信任跳数（仅当部署在反向代理之后才设置，值=代理跳数，如 1；默认不设置=不信任 X-Forwarded-For）
# TRUST_PROXY=1

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_COUNT=10
# 图片缩放缓存目录（相对项目根，默认 cache/images）。
# 注意：必须位于 UPLOAD_DIR 之外，否则缓存文件会被静态服务公开访问。
# UPLOAD_CACHE_DIR=cache/images

# 防盗链 Referer 白名单（逗号分隔；可写 origin 或裸 host）。
# 放行规则：无 Referer、与请求同源、命中本白名单之一；其余返回 403。
# 同源部署（后端托管前端产物）时无需配置；
# 前后端分离部署（如前端 :5173、后端 :3000）必须把前端 origin 配进来，否则静态资源被判为外链。
UPLOAD_ALLOWED_REFERERS=http://localhost:5173

CORS_ORIGIN=http://localhost:5173
LOG_DIR=logs

# 归档根目录（可选，默认 <LOG_DIR>/archive）
# LOG_ARCHIVE_DIR=logs/archive
# 归档时刻（本地时间，默认次日 00:05 归档昨日）
LOG_ARCHIVE_HOUR=0
LOG_ARCHIVE_MINUTE=5
# 归档成功后是否保留源 .log（默认 false=删除）
LOG_ARCHIVE_KEEP_SOURCE=false
# 慢 SQL 阈值（ms）
LOG_SLOW_SQL_MS=200
# 自定义 tar 可执行文件（默认 PATH 中的 tar）
# TAR_BIN=tar

# ── 日志保留策略（按时间列分批 DELETE 自动清理，每日 00:10 触发；单位：天）──
# 保留天数须为**正整数**：设为 0 / 负数 / 非法值时将被拒绝、回退默认值并打印告警（防"0=清空整表"事故）。
# HTTP 访问日志（sys_http_log）保留天数：默认 7。该表是磁盘增长主源，取证价值随时间快速衰减。
LOG_HTTP_RETENTION_DAYS=7
# 操作日志（sys_operation_log）保留天数：默认 180。审计证据，需长期保留。
LOG_OPERATION_RETENTION_DAYS=180
# 登录日志（sys_login_log）保留天数：默认 180（折中）。
LOG_LOGIN_RETENTION_DAYS=180
# 保留清理触发时刻（本地时间，默认 00:10，刻意避开 00:05 归档以避免同一时刻抢 IO）
LOG_RETENTION_HOUR=0
LOG_RETENTION_MINUTE=10
# 是否启用日志保留清理：默认 true；设 false 为紧急刹车（不注册调度器、不执行清理）
LOG_RETENTION_ENABLED=true

# ── Redis（登出令牌黑名单 / 登录频率限制 / 验证码的共享存储）──
# 用途：① 退出登录后服务端立即失效旧令牌（黑名单）；② 登录频率限制跨进程/跨实例共享计数；③ 验证码跨实例共享。
# 降级：留空 REDIS_HOST 即视为不启用——登录与鉴权主流程不受影响，仅上述增强失效。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码可留空；有密码时填写
# REDIS_PASSWORD=
REDIS_DB=0
