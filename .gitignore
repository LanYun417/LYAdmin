# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/
*.local

# 例外：Vditor 自托管静态资源必须入库 —— 否则他人 clone 后构建产物中缺少该目录，
# 编辑器将无法离线渲染（emoji / 内容主题 / 代码高亮 / KaTeX / mermaid）。
!admin/public/vditor/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# Uploads (keep directory, ignore content)
api/uploads/*
!api/uploads/.gitkeep

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache

# AI 助手本地工作数据（会话记忆等，不属于项目源码）
.workbuddy-ai/
.workbuddy
