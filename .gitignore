# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
# 构建验证用的临时输出目录（如 vite build --outDir dist-csscheck）
dist-*/
build/
*.local

# 例外：Vditor 自托管静态资源必须入库 —— 否则他人 clone 后构建产物中缺少该目录，
# 编辑器将无法离线渲染（emoji / 内容主题 / 代码高亮 / KaTeX / mermaid）。
!ly-admin-web/public/vditor/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# Uploads (keep directory, ignore content)
ly-admin-api/uploads/*
!ly-admin-api/uploads/.gitkeep

# 后端运行时产物：图片处理缓存（缩略图等）与前端构建产物映射目录（同源部署时由后端托管）
ly-admin-api/cache/
ly-admin-api/web/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache

# AI 助手本地工作数据（会话记忆、Skills 等，不属于项目源码）
.workbuddy-ai/
.workbuddy/
.agents/
